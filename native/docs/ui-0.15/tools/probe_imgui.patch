@@ -0,0 +1,17 @@
+// UI audit probe (0.15 stage 1). THROWAWAY: copied over a scratch copy of Dear ImGui, never part of the app.
+// With PL_PROBE=<file> it records, for the last frame, every text run, interactive item, closed outline and window.
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#include <cfloat>
+struct PlProbe {
+    std::vector<std::string> cur, last;
+    bool on = false, init = false;
+    void setup() { if (!init) { init = true; on = std::getenv("PL_PROBE") != nullptr; } }
+    void frame() { setup(); if (!on) return; if (!cur.empty()) last = cur; cur.clear(); }
+    void add(const char* fmt, ...) __attribute__((format(printf, 2, 3)));
+    void dump() { if (!on) return; std::FILE* f = std::fopen(std::getenv("PL_PROBE"), "w"); if (!f) return; const auto& v = cur.empty() ? last : cur; for (const auto& s : v) std::fprintf(f, "%s\n", s.c_str()); std::fclose(f); }
+};
+extern PlProbe g_plProbe;
