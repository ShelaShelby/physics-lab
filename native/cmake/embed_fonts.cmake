# Turns the bundled font files (assets/fonts/*.ttf) into C arrays inside the .exe, so the app
# needs no files next to it. Writes ${OUT}: a table of {name, data, size}.
file(GLOB FONTS "${SRC}/*.ttf" "${SRC}/*.otf")
list(SORT FONTS)
set(body "// Generated by cmake/embed_fonts.cmake from assets/fonts. Do not edit.\n#include <cstddef>\nnamespace ui {\n")
set(table "struct EmbeddedFont { const char* name; const unsigned char* data; std::size_t size; };\nextern const EmbeddedFont kEmbeddedFonts[] = {\n")
# 32 bytes per line (CMake's regular expressions have no {32})
set(row "")
foreach(k RANGE 31)
  string(APPEND row "0x[0-9a-f][0-9a-f],")
endforeach()
set(i 0)
foreach(f ${FONTS})
  get_filename_component(name "${f}" NAME_WE)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
  string(APPEND body "static const unsigned char kFont${i}[] = {\n${hex}};\n")
  string(APPEND table "  {\"${name}\", kFont${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND table "  {nullptr, nullptr, 0},\n};\n")
file(WRITE "${OUT}" "${body}${table}}  // namespace ui\n")
