# 0.21 stage 1: turns the Molecule Lab's computed density files (data/molecules/density/*.pld, made by tools/make_density_data.py) into C arrays inside the program,
# as cmake/embed_fonts.cmake does for the fonts. Writes ${OUT}: molecule::dens::embedded(id, size).
file(GLOB FILES "${SRC}/*.pld")
list(SORT FILES)
set(body "// Generated by cmake/embed_density.cmake from data/molecules/density. Do not edit.\n#include <cstddef>\n#include <cstring>\n#include <string>\nnamespace molecule::dens {\nnamespace {\n")
set(table "struct Item { const char* id; const unsigned char* data; std::size_t size; };\nconst Item kItems[] = {\n")
# 8 bytes a number (little endian, as on every PC the app runs on): a quarter of the text of one byte a number, and much faster to compile
set(b "([0-9a-f][0-9a-f])")
set(row "")
foreach(k RANGE 7)
  string(APPEND row "0x[0-9a-f]+,")
endforeach()
set(i 0)
foreach(f ${FILES})
  get_filename_component(name "${f}" NAME_WE)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  math(EXPR pad "(16 - ${n} % 16) % 16")
  if(pad GREATER 0)
    foreach(k RANGE 1 ${pad})
      string(APPEND hex "0")
    endforeach()
  endif()
  string(REGEX REPLACE "${b}${b}${b}${b}${b}${b}${b}${b}" "0x\\8\\7\\6\\5\\4\\3\\2\\1," hex "${hex}")
  string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
  string(APPEND body "const unsigned long long kD${i}[] = {\n${hex}};\n")
  string(APPEND table "  {\"${name}\", reinterpret_cast<const unsigned char*>(kD${i}), ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND table "};\n")
file(WRITE "${OUT}" "${body}${table}}  // namespace\nconst unsigned char* embedded(const std::string& id, std::size_t& size) {\n  for (const Item& it : kItems) if (id == it.id) { size = it.size; return it.data; }\n  size = 0;\n  return nullptr;\n}\n}  // namespace molecule::dens\n")
