# 0.41: turns the Atom Lab's Dirac-Hartree-Fock orbitals (data/dhf/dhf.bin, made by tools/dhf/make_dhf_data.py) into a C array inside the program, as embed_density.cmake does
# for the molecule densities. Writes ${OUT}: atom::hf::embeddedDhf(size).
set(f "${SRC}/dhf.bin")
set(b "([0-9a-f][0-9a-f])")
set(row "")
foreach(k RANGE 7)
  string(APPEND row "0x[0-9a-f]+,")
endforeach()
file(READ "${f}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
math(EXPR pad "(16 - ${n} % 16) % 16")
if(pad GREATER 0)
  foreach(k RANGE 1 ${pad})
    string(APPEND hex "0")
  endforeach()
endif()
# 8 bytes a number (little endian, as on every PC the app runs on)
string(REGEX REPLACE "${b}${b}${b}${b}${b}${b}${b}${b}" "0x\\8\\7\\6\\5\\4\\3\\2\\1," hex "${hex}")
string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
file(WRITE "${OUT}" "// Generated by cmake/embed_dhf.cmake from data/dhf/dhf.bin. Do not edit.\n#include <cstddef>\nnamespace atom::hf {\nnamespace {\nconst unsigned long long kDhf[] = {\n${hex}};\n}  // namespace\nconst unsigned char* embeddedDhf(std::size_t& size) { size = ${size}; return reinterpret_cast<const unsigned char*>(kDhf); }\n}  // namespace atom::hf\n")
