# Turns the picture maps (assets/maps/*.jpg: the planets' surfaces and the Gaia sky) into C arrays
# inside the .exe, as embed_fonts.cmake does for the fonts. Writes ${OUT}: a table of {name, data, size}.
file(GLOB MAPS "${SRC}/*.jpg")
list(SORT MAPS)
set(body "// Generated by cmake/embed_maps.cmake from assets/maps. Do not edit.\n#include <cstddef>\nnamespace render {\n")
set(table "struct EmbeddedMap { const char* name; const unsigned char* data; std::size_t size; };\nextern const EmbeddedMap kEmbeddedMaps[] = {\n")
set(row "")
foreach(k RANGE 31)
  string(APPEND row "0x[0-9a-f][0-9a-f],")
endforeach()
set(i 0)
foreach(f ${MAPS})
  get_filename_component(name "${f}" NAME_WE)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
  string(APPEND body "static const unsigned char kMap${i}[] = {\n${hex}};\n")
  string(APPEND table "  {\"${name}\", kMap${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND table "  {nullptr, nullptr, 0},\n};\n")
file(WRITE "${OUT}" "${body}${table}}  // namespace render\n")
