# 0.85.0: turns the measured sunspot groups (data/sun/spots/sunspot_groups.bin, made by tools/make_sunspot_table.py) into a C array inside the program, as
# embed_dhf.cmake does. Writes ${OUT}: orbit::embeddedSunspots(size).
set(f "${SRC}/sunspot_groups.bin")
set(b "([0-9a-f][0-9a-f])")
set(row "")
foreach(k RANGE 7)
  string(APPEND row "0x[0-9a-f]+,")
endforeach()
file(READ "${f}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
math(EXPR pad "(16 - ${n} % 16) % 16")
if(pad GREATER 0)
  foreach(k RANGE 1 ${pad})
    string(APPEND hex "0")
  endforeach()
endif()
# 8 bytes a number (little endian, as on every PC the app runs on)
string(REGEX REPLACE "${b}${b}${b}${b}${b}${b}${b}${b}" "0x\\8\\7\\6\\5\\4\\3\\2\\1," hex "${hex}")
string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
file(WRITE "${OUT}" "// Generated by cmake/embed_spots.cmake from data/sun/spots/sunspot_groups.bin. Do not edit.\n#include <cstddef>\nnamespace orbit {\nnamespace {\nconst unsigned long long kSpots[] = {\n${hex}};\n}  // namespace\nconst unsigned char* embeddedSunspots(std::size_t& size) { size = ${size}; return reinterpret_cast<const unsigned char*>(kSpots); }\n}  // namespace orbit\n")
