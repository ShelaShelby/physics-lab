# 0.47.2: the GRASP2018 clouds of the one-outer-electron atoms (0.47.3: and of the two-s-electron atoms, levels.h) (data/jumps/grasp/<X>/clouds.bin, tools/grasp/multipoles.py) as C arrays, as embed_dhf.cmake does.
# Writes ${OUT}: atom::embeddedGrasp(Z, size) (nullptr when the atom has none).
set(b "([0-9a-f][0-9a-f])")
set(row "")
foreach(k RANGE 7)
  string(APPEND row "0x[0-9a-f]+,")
endforeach()
set(body "")
set(cases "")
foreach(pair Li:3 Na:11 K:19 Rb:37 Cs:55 Fr:87 He:2 Be:4 Mg:12 Ca:20 Zn:30 Sr:38 Cd:48 Ba:56 Yb:70 Hg:80 Ra:88)
  string(REPLACE ":" ";" pv "${pair}")
  list(GET pv 0 X)
  list(GET pv 1 Z)
  set(f "${SRC}/${X}/clouds.bin")
  if(NOT EXISTS "${f}")
    continue()
  endif()
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  math(EXPR pad "(16 - ${n} % 16) % 16")
  if(pad GREATER 0)
    foreach(k RANGE 1 ${pad})
      string(APPEND hex "0")
    endforeach()
  endif()
  string(REGEX REPLACE "${b}${b}${b}${b}${b}${b}${b}${b}" "0x\\8\\7\\6\\5\\4\\3\\2\\1," hex "${hex}")
  string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
  string(APPEND body "const unsigned long long kGrasp${X}[] = {\n${hex}};\n")
  string(APPEND cases "    case ${Z}: size = ${size}; return reinterpret_cast<const unsigned char*>(kGrasp${X});\n")
endforeach()
file(WRITE "${OUT}" "// Generated by cmake/embed_grasp.cmake from data/jumps/grasp/*/clouds.bin. Do not edit.\n#include <cstddef>\nnamespace atom {\nnamespace {\n${body}}  // namespace\nconst unsigned char* embeddedGrasp(int Z, std::size_t& size) {\n    switch (Z) {\n${cases}    default: size = 0; return nullptr;\n    }\n}\n}  // namespace atom\n")
